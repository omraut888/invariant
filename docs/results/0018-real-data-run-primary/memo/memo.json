form":"value","id":"causal.sig_rv_spy.best_lag","type":"fact"}],[{"form":"value","id":"causal.sig_rv_spy.r_best","type":"fact"}]],[[{"text":"sig_term_spread","type":"text"}],[{"form":"value","id":"causal.sig_term_spread.family_p","type":"fact"}],[{"form":"value","id":"causal.sig_term_spread.q","type":"fact"}],[{"form":"value","id":"causal.sig_term_spread.best_asset","type":"fact"},{"text":", lag ","type":"text"},{"form":"value","id":"causal.sig_term_spread.best_lag","type":"fact"}],[{"form":"value","id":"causal.sig_term_spread.r_best","type":"fact"}]],[[{"text":"sig_tsmom_spy","type":"text"}],[{"form":"value","id":"causal.sig_tsmom_spy.family_p","type":"fact"}],[{"form":"value","id":"causal.sig_tsmom_spy.q","type":"fact"}],[{"form":"value","id":"causal.sig_tsmom_spy.best_asset","type":"fact"},{"text":", lag ","type":"text"},{"form":"value","id":"causal.sig_tsmom_spy.best_lag","type":"fact"}],[{"form":"value","id":"causal.sig_tsmom_spy.r_best","type":"fact"}]],[[{"text":"sig_unrate_change","type":"text"}],[{"form":"value","id":"causal.sig_unrate_change.family_p","type":"fact"}],[{"form":"value","id":"causal.sig_unrate_change.q","type":"fact"}],[{"form":"value","id":"causal.sig_unrate_change.best_asset","type":"fact"},{"text":", lag ","type":"text"},{"form":"value","id":"causal.sig_unrate_change.best_lag","type":"fact"}],[{"form":"value","id":"causal.sig_unrate_change.r_best","type":"fact"}]],[[{"text":"sig_vrp","type":"text"}],[{"form":"value","id":"causal.sig_vrp.family_p","type":"fact"}],[{"form":"value","id":"causal.sig_vrp.q","type":"fact"}],[{"form":"value","id":"causal.sig_vrp.best_asset","type":"fact"},{"text":", lag ","type":"text"},{"form":"value","id":"causal.sig_vrp.best_lag","type":"fact"}],[{"form":"value","id":"causal.sig_vrp.r_best","type":"fact"}]]]}],"id":"causal","title":"Causal screen"},{"blocks":[{"kind":"paragraph","origin":"template","segments":[{"text":"This run used market data, with known limits (","type":"text"},{"number":4,"type":"adr"},{"text":"): the ETF universe has survivorship and hindsight bias, and price levels are not point-in-time, so only returns are used. Daily FRED market series are used as FRED first posted them once their archive begins; before it, each value is assumed usable a fixed number of sessions after its date, set from the archive's regular posting delays, and revisions before the archive cannot be seen (","type":"text"},{"number":19,"type":"adr"},{"text":"). Macro series are the vintages known at each date, and their changes are computed within one vintage (","type":"text"},{"number":19,"type":"adr"},{"text":"). ","type":"text"},{"stage":"causal","type":"stage"},{"text":" tests lags starting one session back, which includes a link a trade entered at the next session's close could not use; ","type":"text"},{"stage":"portfolio","type":"stage"},{"text":" trades at that close, so it alone tests what could have been traded (","type":"text"},{"number":18,"type":"adr"},{"text":"). Every rate this memo quotes from the planted-signal benchmark is a benchmark validation rate, measured on synthetic data with a known answer. It describes how the pipeline's tests behave, and is not a property of this strategy.","type":"text"}],"statement":"data_source"},{"kind":"paragraph","origin":"template","segments":[{"text":"A sensitivity run on the same snapshot and seed used the maximum-lag rule for the daily FRED market series: current values throughout, each usable only after the longest posting delay the archive shows (","type":"text"},{"number":18,"type":"adr"},{"text":"; sensitivity run ","type":"text"},{"form":"value","id":"sensitivity.run_id","type":"fact"},{"text":"). Every signal's outcome there is the same as in this run, so no result here depends on that choice of posting lag.","type":"text"}],"statement":"lag_sensitivity_agrees"},{"kind":"paragraph","origin":"template","segments":[{"text":"A kill at ","type":"text"},{"stage":"causal","type":"stage"},{"text":" means the edge was not detectable at this sample size, not that there is no effect. The test has little power against weak edges. ","type":"text"},{"form":"full","id":"ref.realistic_stage1_power","type":"fact"},{"text":". ","type":"text"},{"form":"full","id":"ref.base_stage1_power","type":"fact"},{"text":".","type":"text"}],"statement":"not_detectable"},{"kind":"paragraph","origin":"template","segments":[{"text":"At ","type":"text"},{"stage":"causal","type":"stage"},{"text":", the best lag is where the evidence was strongest, not an identified horizon, and the partial-correlation intervals are descriptive: they are not adjusted for the selection of the link and ran narrow on the benchmark (","type":"text"},{"number":10,"type":"adr"},{"text":").","type":"text"}],"statement":"stage1_descriptive"},{"kind":"paragraph","origin":"template","segments":[{"stage":"adversarial","type":"stage"},{"text":" was evaluated and not adopted as a kill stage (","type":"text"},{"number":16,"type":"adr"},{"text":"). At about twenty-four years of daily data, the plausible variation in a strategy's exposure to high-volatility periods is too small to overturn a strategy that is profitable on average, and a rule that killed for losing money in stress would penalise ordinary market exposure rather than fragility. ","type":"text"},{"form":"full","id":"ref.stage4_worst_case","type":"fact"},{"text":".","type":"text"}],"statement":"stage4_not_adopted"}],"id":"limits","title":"Limits that apply to this run"},{"blocks":[{"kind":"paragraph","origin":"template","segments":[{"stage":"causal","type":"stage"},{"text":": PCMCI (","type":"text"},{"key":"runge2019","type":"cite"},{"text":") with an ","type":"text"},{"term":"hc3","type":"term"},{"text":" partial-correlation test (","type":"text"},{"key":"mackinnon1985","type":"cite"},{"text":"), Bonferroni over each signal's lags and assets, and the Benjamini-Hochberg procedure across signals (","type":"text"},{"key":"benjamini1995","type":"cite"},{"text":") (","type":"text"},{"number":9,"type":"adr"},{"text":", ","type":"text"},{"number":10,"type":"adr"},{"text":"). Persistent predictors distort such tests in small samples (","type":"text"},{"key":"stambaugh1999","type":"cite"},{"text":"), which is why the stage requires a minimum sample.","type":"text"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"text":"Benchmark validation rates carry Wilson intervals (","type":"text"},{"key":"wilson1927","type":"cite"},{"text":").","type":"text"}],"statement":null}],"id":"methods","title":"Methods"},{"blocks":[{"kind":"paragraph","origin":"template","segments":[{"form":"full","id":"run.run_id","type":"fact"},{"text":"; ","type":"text"},{"form":"full","id":"run.snapshot_id","type":"fact"},{"text":"; ","type":"text"},{"form":"full","id":"run.git_sha","type":"fact"},{"text":"; ","type":"text"},{"form":"full","id":"run.seed","type":"fact"},{"text":"; ","type":"text"},{"form":"full","id":"run.n_obs","type":"fact"},{"text":", from ","type":"text"},{"form":"value","id":"run.first_date","type":"fact"},{"text":" to ","type":"text"},{"form":"value","id":"run.last_date","type":"fact"},{"text":". A run is keyed by a hash of its data snapshot, config, code commit and seed (","type":"text"},{"number":2,"type":"adr"},{"text":"); every decision is in its hash-chained kill ledger (","type":"text"},{"number":7,"type":"adr"},{"text":").","type":"text"}],"statement":null}],"id":"reproducibility","title":"Reproducibility"},{"blocks":[{"kind":"paragraph","origin":"template","segments":[{"key":"ang2007","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"benjamini1995","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"bollerslev2009","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"boyd2005","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"campbell1987","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"fama1977","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"fama1989","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"fama1990","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"flannery2002","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"french1987","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"keim1986","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"mackinnon1985","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"moreira2017","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"moskowitz2012","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"runge2019","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"stambaugh1999","type":"bibliography"}],"statement":null},{"kind":"paragraph","origin":"template","segments":[{"key":"wilson1927","type":"bibliography"}],"statement":null}],"id":"references","title":"References"}],"title":"Research memo"}
